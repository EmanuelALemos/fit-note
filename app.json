{
  "expo": {
    "name": "Fit Note",
    "slug": "fit-note",
    "version": "2.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#404040"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#404040"
      },
      "package": "com.emanuellemos.fitnote",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#404040"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0f25bfd2-f616-4fc4-a297-5dec50a403b0"
      }
    },
    "owner": "emanuel_araujo20"
  }
}
